# =====================================================================
# GTA6 VIRAL CLIPPER PRO - ENVIRONMENT CREDENTIALS TEMPLATE
# Copy this file to .env and fill in your API keys / OAuth secrets.
# =====================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_OAUTH_CONNECTED=false

# Canva Pro API
CANVA_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=
CANVA_OAUTH_CONNECTED=false

# Instagram Reels Integration (Direct Account OR Meta Graph API)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Pipeline Defaults
STREAMLIT_SERVER_PORT=8501
PARALLEL_WORKERS=3
CLIPS_PER_STREAM=2
CLIP_DURATION_SECONDS=35
MAX_CAPTURE_MINUTES=30
LIVE_MODE=record_buffer
OUTPUT_DIR=Output_Clips
AUTO_SUBTITLES=true
BURN_HOOK_BANNER=true
AUTO_CLEANUP=true
